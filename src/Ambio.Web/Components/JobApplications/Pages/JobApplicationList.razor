@page "/applications"
@inject IJobApplicationService JobApplicationService

<PageTitle>Applications</PageTitle>
<AppBarTitle>Applications</AppBarTitle>

<PageHeader Title="Applications" Subtitle="The jobs you applied to, or are about to">
    <Actions>
        <ButtonLink Href="@JobApplicationRoutes.New" Variant="ButtonVariant.Primary" Icon="plus-lg">New application</ButtonLink>
    </Actions>
</PageHeader>

@if (_list is { Total: 0, HasArchived: false } && _filter.IsEmpty)
{
    <section class="card">
        <EmptyState Icon="inbox" Title="No applications yet">
            <ChildContent>Log the jobs you apply to and follow each one from draft to offer. Start from a job ad, or record a spontaneous application.</ChildContent>
            <Actions>
                <ButtonLink Href="@JobApplicationRoutes.New" Variant="ButtonVariant.Primary" Icon="plus-lg">New application</ButtonLink>
                <ButtonLink Href="@OfferRoutes.New" Variant="ButtonVariant.Secondary">Add an offer</ButtonLink>
            </Actions>
        </EmptyState>
    </section>
}
else if (_list is not null)
{
    <JobApplicationFilters Filter="_filter" Companies="_companies" CountsByStatus="_list.CountsByStatus" />

    @if (_list.Total == 0 && _filter.IsEmpty)
    {
        <section class="card">
            <EmptyState Icon="archive" Title="Every application is archived">
                <ChildContent>Archived applications are hidden from this list. Show them to find one again, or log a new application.</ChildContent>
                <Actions>
                    <ButtonLink Href="@JobApplicationRoutes.Filtered(_filter with { IncludeArchived = true })" Variant="ButtonVariant.Secondary">Show archived</ButtonLink>
                    <ButtonLink Href="@JobApplicationRoutes.New" Variant="ButtonVariant.Primary" Icon="plus-lg">New application</ButtonLink>
                </Actions>
            </EmptyState>
        </section>
    }
    else if (_list.Total == 0)
    {
        <section class="card">
            <EmptyState Icon="search" Title="No matching applications">
                <ChildContent>No application matches this search or these filters. Change them, or clear them to see every application.</ChildContent>
                <Actions>
                    <ButtonLink Href="@JobApplicationRoutes.List" Variant="ButtonVariant.Secondary">Clear filters</ButtonLink>
                </Actions>
            </EmptyState>
        </section>
    }
    else
    {
        <ResponsiveList Items="_list.Applications">
            <Card Context="application"><JobApplicationCard Application="application" /></Card>
            <Table><JobApplicationTable Applications="_list.Applications" /></Table>
            <Footer>
                @if (_list.Applications.Count < _list.Total)
                {
                    <ListFooter Shown="_list.Applications.Count" Total="_list.Total"
                                MoreHref="@JobApplicationRoutes.Filtered(_filter, _list.Applications.Count + PageSize)" />
                }
            </Footer>
        </ResponsiveList>
    }
}

@* On mobile, the page's main action floats above the tab bar (docs/ui.md#layout). *@
<ButtonLink Href="@JobApplicationRoutes.New" Variant="ButtonVariant.Primary" Icon="plus-lg" class="btn-fab mobile-only" aria-label="New application" />

@code {
    /// <summary>The number of applications shown at first, and added by each "Load more".</summary>
    public const int PageSize = 25;

    [SupplyParameterFromQuery(Name = JobApplicationRoutes.SearchQuery)]
    public string? Search { get; set; }

    [SupplyParameterFromQuery(Name = JobApplicationRoutes.StatusQuery)]
    public string? Status { get; set; }

    [SupplyParameterFromQuery(Name = JobApplicationRoutes.CompanyQuery)]
    public string? Company { get; set; }

    [SupplyParameterFromQuery(Name = JobApplicationRoutes.KindQuery)]
    public string? Kind { get; set; }

    [SupplyParameterFromQuery(Name = ShowArchived.Query)]
    public string? Archived { get; set; }

    [SupplyParameterFromQuery(Name = JobApplicationRoutes.ShownQuery)]
    public int? Shown { get; set; }

    private JobApplicationFilter _filter = new();
    private JobApplicationListDto? _list;
    private IReadOnlyList<CompanySummaryDto> _companies = [];

    // A value that names no status or kind is ignored, as is a number shown smaller than a page.
    protected override async Task OnInitializedAsync()
    {
        _filter = new JobApplicationFilter(
            Status: QueryValue.Parse<ApplicationStatus>(Status),
            CompanySlug: string.IsNullOrWhiteSpace(Company) ? null : Company,
            Kind: QueryValue.Parse<ApplicationKind>(Kind),
            Search: string.IsNullOrWhiteSpace(Search) ? null : Search.Trim(),
            IncludeArchived: ShowArchived.IsChecked(Archived));
        _list = await JobApplicationService.ListAsync(_filter, Math.Max(PageSize, Shown ?? 0));
        _companies = await JobApplicationService.ListCompaniesAsync(_filter.IncludeArchived);
    }
}
