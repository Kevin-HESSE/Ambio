@* The "Status" card of the application page, in its side column (docs/ui.md#patterns): the status and the day it was
   reached. *@
<section class="card status-panel" aria-label="Status">
    <div class="card-body cluster justify-content-between">
        <div class="stack align-items-start">
            <span class="t-small t-muted">Status</span>
            <StatusBadge Status="Status" />
        </div>
        <span class="status-panel-since t-small t-muted text-nowrap">since <time datetime="@Since.ToString("yyyy-MM-dd")">@Since.ToShortDisplayDate()</time></span>
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public ApplicationStatus Status { get; set; }

    /// <summary>When the application reached its status (UTC): its last change, or its creation.</summary>
    [Parameter, EditorRequired]
    public DateTime Since { get; set; }
}
