@* An application in a list inside a card, such as on the offer page or in the Applications tab of the company page:
   its status, then when and where it was sent, linking to its page, dimmed when archived. *@
<a class="application-item" href="@JobApplicationRoutes.Details(Application.ShortId, Application.Slug)">
    <div class="application-item-text stack">
        @if (ShowTitle)
        {
            <span class="application-item-title t-body-strong @(Application.IsArchived ? "t-muted" : null)">@Application.Title</span>
        }
        <div class="cluster">
            <StatusBadge Status="Application.Status" />
            @if (Application.Kind == ApplicationKind.Spontaneous)
            {
                <SpontaneousTag />
            }
            @if (Application.IsArchived)
            {
                <ArchivedTag />
            }
            <span class="application-item-meta t-small t-secondary">
                @if (Application.SentOn is { } sentOn)
                {
                    @("Sent ")<time datetime="@sentOn.ToString("yyyy-MM-dd")">@sentOn.ToDisplayDate()</time>
                    @if (Application.AppliedVia is not null)
                    {
                        @($" via {Application.AppliedVia}")
                    }
                }
                else
                {
                    @("Not sent yet")
                }
            </span>
        </div>
    </div>
    <i class="bi bi-chevron-right t-muted" aria-hidden="true"></i>
</a>

@code {
    [Parameter, EditorRequired]
    public JobApplicationSummaryDto Application { get; set; } = null!;

    /// <summary>Shows the offer's title, where the list mixes several offers.</summary>
    [Parameter]
    public bool ShowTitle { get; set; }
}
