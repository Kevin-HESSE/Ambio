@* An offer in the mobile list (< 992 px), linking to its page. *@
<a class="offer-card stack" href="@OfferRoutes.Details(Offer.Id)">
    <div class="offer-card-head">
        <span class="offer-title t-body-strong">@Offer.Title</span>
        <time class="offer-date t-small t-muted" datetime="@Offer.RegisterAt.ToString("yyyy-MM-dd")">@Offer.RegisterAt.ToShortDisplayDate()</time>
    </div>
    <div class="offer-company t-small t-secondary">@Offer.CompanyName</div>
    <div class="offer-tags cluster">
        <OfferTags ContractType="Offer.ContractType" RemotePolicy="Offer.RemotePolicy" />
        <span class="offer-postings t-small t-muted">
            <CountBadge Count="Offer.PostingCount" class="offer-postings-count" />
            @OfferLabels.PostingWord(Offer.PostingCount)
        </span>
    </div>
</a>

@code {
    [Parameter, EditorRequired]
    public JobOfferSummaryDto Offer { get; set; } = null!;
}
