@page "/companies/{Slug}"
@attribute [Authorize]
@inject ICompanyService CompanyService
@inject IJobOfferService JobOfferService
@inject NavigationManager NavigationManager

@if (_company is not null)
{
    <PageTitle>@_company.Name</PageTitle>
    <AppBarBack Href="@CompanyRoutes.List" />
    <AppBarTitle>Company</AppBarTitle>
    <AppBarActions>
        <ButtonLink Href="@CompanyRoutes.Edit(_company.Slug)" Icon="pencil" IconOnly aria-label="Edit company" />
    </AppBarActions>

    <div class="company-detail detail-layout">
        <DetailHeader Title="@_company.Name" ParentTitle="Companies" ParentHref="@CompanyRoutes.List">
            <Tags>
                <Tag Icon="building">@_company.Kind.ToLabel()</Tag>
            </Tags>
            <Actions>
                <ButtonLink Href="@CompanyRoutes.Edit(_company.Slug)" Variant="ButtonVariant.Secondary" Icon="pencil">Edit</ButtonLink>
            </Actions>
        </DetailHeader>

        <div class="company-detail-aside detail-aside">
            <CompanyProfile Company="_company" />
        </div>

        <div class="company-detail-main detail-main stack">
            <section class="card" aria-label="Description">
                <div class="card-body">
                    @if (_company.Description is not null)
                    {
                        <p class="company-description prose">@_company.Description</p>
                    }
                    else
                    {
                        <p class="company-description-empty t-muted">No description yet.</p>
                    }
                </div>
            </section>

            @* The Applications tab comes with the applications (#48). *@
            <TabNav Label="Company sections" Tabs="Tabs" Active="@CompanyRoutes.OffersTab" />
            <section class="card" aria-label="Offers">
                @if (_offers is { Count: 0 })
                {
                    <EmptyState Icon="briefcase" Title="No offers yet">
                        <ChildContent>The offers you save for this company show up here.</ChildContent>
                        <Actions>
                            <ButtonLink Href="@OfferRoutes.New" Variant="ButtonVariant.Primary" Icon="plus-lg">New offer</ButtonLink>
                        </Actions>
                    </EmptyState>
                }
                else
                {
                    <ul class="company-offers list-divided">
                        @foreach (var offer in _offers)
                        {
                            <li><OfferListItem Offer="offer" /></li>
                        }
                    </ul>
                }
            </section>
        </div>
    </div>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    private CompanyDetailsDto? _company;

    private IReadOnlyList<JobOfferSummaryDto> _offers = [];

    private IReadOnlyList<TabNavItem> Tabs =>
    [
        new(CompanyRoutes.OffersTab, "Offers", CompanyRoutes.Details(_company!.Slug, CompanyRoutes.OffersTab), _offers.Count),
    ];

    protected override async Task OnInitializedAsync()
    {
        _company = await CompanyService.GetAsync(Slug);

        if (_company is null)
        {
            NavigationManager.NotFound();
            return;
        }

        _offers = await JobOfferService.ListByCompanyAsync(_company.Id);
    }
}
