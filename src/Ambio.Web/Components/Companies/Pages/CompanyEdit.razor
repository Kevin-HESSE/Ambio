@page "/companies/{Slug}/edit"
@inject ICompanyService CompanyService
@inject NavigationManager NavigationManager

@if (_company is not null)
{
    <PageTitle>Edit @_company.Name</PageTitle>
    <AppBarBack Href="@CompanyRoutes.Details(_company.Slug)" />
    <AppBarTitle>Edit company</AppBarTitle>

    <PageHeader Title="Edit company" Subtitle="@_company.Name" />

    <section class="card form-page">
        <EditForm Model="Input" method="post" OnValidSubmit="UpdateCompany" FormName="edit-company" novalidate class="card-body form-sections">
            <DataAnnotationsValidator />

            <CompanyFormFields Input="Input" />

            <div class="action-bar">
                <ButtonLink Href="@CompanyRoutes.Details(_company.Slug)" Variant="ButtonVariant.Secondary">Cancel</ButtonLink>
                <button type="submit" class="btn btn-primary">Save changes</button>
            </div>
        </EditForm>
    </section>
}

@code {
    [Parameter]
    public string Slug { get; set; } = "";

    [SupplyParameterFromForm]
    private CompanyInput Input { get; set; } = default!;

    // The company as saved: it names the page, even while the form holds unsaved changes.
    private CompanyDetailsDto? _company;

    protected override async Task OnInitializedAsync()
    {
        _company = await CompanyService.GetAsync(Slug);

        if (_company is null)
        {
            NavigationManager.NotFound();
            return;
        }

        // On a post, Input already holds the submitted values.
        Input ??= _company.ToInput();
    }

    private async Task UpdateCompany(EditContext editContext)
    {
        var result = await CompanyService.UpdateAsync(_company!.Id, Input);

        // A rename gives the company a new slug: the page it goes back to has a new URL.
        if (result.TryGetValue(out var slug))
        {
            NavigationManager.NavigateTo(CompanyRoutes.Details(slug));
            return;
        }

        if (result.GetMessage == CompanyErrors.NotFound)
        {
            NavigationManager.NotFound();
            return;
        }

        // The other failure is a duplicate name: the message goes under the Name field.
        new ValidationMessageStore(editContext).Add(() => Input.Name, result.GetMessage);
        editContext.NotifyValidationStateChanged();
    }
}
