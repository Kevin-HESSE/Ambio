@* A company in the mobile list (< 992 px), linking to its page, dimmed when archived. *@
<ListCard Title="@Company.Name" Href="@CompanyRoutes.Details(Company.Slug)" Subtitle="@Details" Archived="Company.IsArchived">
    <Tags>
        <Tag Icon="building">@Company.Kind.ToLabel()</Tag>
        @if (Company.IsArchived)
        {
            <ArchivedTag />
        }
    </Tags>
</ListCard>

@code {
    [Parameter, EditorRequired]
    public CompanySummaryDto Company { get; set; } = null!;

    private string Details => string.Join(" · ", new[] { Company.Industry, Company.Location }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
