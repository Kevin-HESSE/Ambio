@* A company in the mobile list (< 992 px), linking to its page. *@
<ListCard Title="@Company.Name" Href="@CompanyRoutes.Details(Company.Slug)" Subtitle="@Details">
    <Tags><Tag Icon="building">@Company.Kind.ToLabel()</Tag></Tags>
</ListCard>

@code {
    [Parameter, EditorRequired]
    public CompanySummaryDto Company { get; set; } = null!;

    private string Details => string.Join(" · ", new[] { Company.Industry, Company.Location }.Where(value => !string.IsNullOrWhiteSpace(value)));
}
