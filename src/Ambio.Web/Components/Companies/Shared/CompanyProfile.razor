@* The "Profile" card of the company page: only the filled-in fields are listed. *@
<section class="card company-profile" aria-labelledby="company-profile-title">
    <div class="card-header">
        <h2 id="company-profile-title" class="t-h3">Profile</h2>
    </div>
    <div class="card-body">
        @if (HasDetails)
        {
            <dl class="company-profile-list">
                @if (Company.Website is not null)
                {
                    <div class="stack">
                        <dt class="t-small t-muted">Website</dt>
                        <dd><ExternalLink Href="@Company.Website" /></dd>
                    </div>
                }
                @if (Company.Industry is not null)
                {
                    <div class="stack">
                        <dt class="t-small t-muted">Industry</dt>
                        <dd>@Company.Industry</dd>
                    </div>
                }
                @if (Company.Size is { } size)
                {
                    <div class="stack">
                        <dt class="t-small t-muted">Size</dt>
                        <dd>@size.ToLabel()</dd>
                    </div>
                }
                @if (Company.Location is not null)
                {
                    <div class="stack">
                        <dt class="t-small t-muted">Location</dt>
                        <dd>@Company.Location</dd>
                    </div>
                }
                @if (Company.LinkedInUrl is not null)
                {
                    <div class="stack">
                        <dt class="t-small t-muted">LinkedIn</dt>
                        <dd><ExternalLink Href="@Company.LinkedInUrl" /></dd>
                    </div>
                }
            </dl>
        }
        else
        {
            <p class="company-profile-empty t-muted">No details yet.</p>
        }
    </div>
</section>

@code {
    [Parameter, EditorRequired]
    public CompanyDetailsDto Company { get; set; } = null!;

    private bool HasDetails =>
        Company is not { Website: null, Industry: null, Size: null, Location: null, LinkedInUrl: null };
}
