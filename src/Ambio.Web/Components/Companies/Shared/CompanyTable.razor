@* The companies list on desktop (≥ 992 px). *@
<ListTable>
    <Columns>
        <th scope="col">Company</th>
        <th scope="col">Kind</th>
        <th scope="col">Location</th>
    </Columns>
    <Rows>
        @foreach (var company in Companies)
        {
            <tr>
                <th scope="row">
                    <a class="company-name t-body-strong" href="@CompanyRoutes.Details(company.Slug)">@company.Name</a>
                    @if (!string.IsNullOrWhiteSpace(company.Industry))
                    {
                        <div class="company-industry t-small t-secondary">@company.Industry</div>
                    }
                </th>
                <td><Tag Icon="building">@company.Kind.ToLabel()</Tag></td>
                <td>@company.Location</td>
            </tr>
        }
    </Rows>
</ListTable>

@code {
    [Parameter, EditorRequired]
    public IReadOnlyList<CompanySummaryDto> Companies { get; set; } = [];
}
