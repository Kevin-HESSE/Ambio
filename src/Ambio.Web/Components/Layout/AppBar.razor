@using Microsoft.AspNetCore.Components.Sections

@* Mobile only (< 992 px). Pages give their title with <AppBarTitle>. *@
<header class="appbar">
    <Logo MarkOnly />
    <div class="appbar-title"><SectionOutlet SectionName="@TitleSection" /></div>
</header>

@code {
    /// <summary>Section filled by <see cref="AppBarTitle"/>.</summary>
    public const string TitleSection = "app-bar-title";
}
