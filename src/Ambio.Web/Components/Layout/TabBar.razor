@inject NavigationManager NavigationManager

@* Mobile only (< 992 px): the sections, then "More", which opens the More sheet. *@
<nav class="tabbar" aria-label="Main navigation">
    @foreach (var entry in AppNavigation.Tracking)
    {
        <NavLink class="tab" href="@entry.Href" Match="entry.Match">
            <span class="tab-indicator">
                <i class="bi bi-@entry.Icon nav-icon" aria-hidden="true"></i>
                <i class="bi bi-@entry.ActiveIcon nav-icon-active" aria-hidden="true"></i>
            </span>
            @entry.TabLabel
        </NavLink>
    }
    <button type="button" class="@ComponentClass"
            data-sheet-open="@MoreSheet.Id" aria-haspopup="dialog" aria-controls="@MoreSheet.Id">
        <span class="tab-indicator"><i class="bi bi-three-dots" aria-hidden="true"></i></span>
        More
    </button>
</nav>

@code {
    private bool IsMoreActive
    {
        get
        {
            var path = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
            return AppNavigation.MoreRoutes.Any(route => path.StartsWith(route, StringComparison.OrdinalIgnoreCase));
        }
    }

    private string ComponentClass => CssClassHelper.Serialize(
        ["tab"],
        new Dictionary<string, bool> { ["active"] = IsMoreActive });
}
