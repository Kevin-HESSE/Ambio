@* A link to another site, opened in a new tab. It shows the host and the path without the scheme and "www.",
   such as "linkedin.com/company/brightwave". *@
<a class="external-link" href="@Href" target="_blank" rel="noopener noreferrer">
    <span class="external-link-text">@ShortText(Href)</span>
    <i class="bi bi-box-arrow-up-right" aria-hidden="true"></i>
</a>

@code {
    /// <summary>An absolute http or https URL.</summary>
    [Parameter, EditorRequired]
    public string Href { get; set; } = "";

    /// <summary>The URL without its scheme, "www.", query, fragment and final slash; the URL itself when it isn't absolute.</summary>
    public static string ShortText(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            return url;
        }

        var host = uri.Host.StartsWith("www.", StringComparison.OrdinalIgnoreCase) ? uri.Host[4..] : uri.Host;
        return (host + uri.AbsolutePath).TrimEnd('/');
    }
}
