@* The header of a detail page, shown at every width (docs/ui.md#patterns): breadcrumb (desktop), title, tags
   and actions (desktop). On mobile the actions go in the app bar (<AppBarActions>). *@
<div class="detail-head">
    <div class="detail-head-text">
        <nav class="detail-breadcrumb t-small" aria-label="Breadcrumb">
            <a href="@ParentHref">@ParentTitle</a>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
            <span aria-current="page">@Title</span>
        </nav>
        <h1 class="detail-title">@Title</h1>
        @if (Tags is not null)
        {
            <div class="detail-tags">@Tags</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="detail-actions">@Actions</div>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>Name of the parent page in the breadcrumb, such as "Companies".</summary>
    [Parameter, EditorRequired]
    public string ParentTitle { get; set; } = "";

    /// <summary>Base-relative URL of the parent page.</summary>
    [Parameter, EditorRequired]
    public string ParentHref { get; set; } = "";

    /// <summary>Tags under the title, usually <see cref="Tag"/> components.</summary>
    [Parameter]
    public RenderFragment? Tags { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }
}
