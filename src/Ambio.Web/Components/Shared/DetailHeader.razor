@* The header of a detail page, shown at every width (docs/ui.md#patterns): breadcrumb (desktop), title, subtitle,
   tags, then actions and the ⋯ menu (desktop). On mobile the actions go in the app bar (<AppBarActions>), with a
   DetailMenuButton that opens the menu in a sheet. *@
<div class="detail-head">
    <div class="detail-head-text stack">
        <nav class="detail-breadcrumb desktop-only t-small t-muted" aria-label="Breadcrumb">
            <a href="@ParentHref">@ParentTitle</a>
            <i class="bi bi-chevron-right" aria-hidden="true"></i>
            <span aria-current="page">@Title</span>
        </nav>
        <h1 class="detail-title">@Title</h1>
        @if (Subtitle is not null)
        {
            <div class="detail-subtitle t-secondary">@Subtitle</div>
        }
        @if (Tags is not null)
        {
            <div class="detail-tags cluster">@Tags</div>
        }
    </div>
    @if (Actions is not null || Menu is not null)
    {
        <div class="detail-actions desktop-only">
            @Actions
            @if (Menu is not null)
            {
                <ActionMenu Id="detail-menu-popover">@Menu</ActionMenu>
            }
        </div>
    }
    @if (Menu is not null)
    {
        <Sheet Id="@DetailMenuButton.SheetId" Label="More actions">
            <ul class="menu-list">@Menu</ul>
        </Sheet>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public string Title { get; set; } = "";

    /// <summary>Name of the parent page in the breadcrumb, such as "Companies".</summary>
    [Parameter, EditorRequired]
    public string ParentTitle { get; set; } = "";

    /// <summary>Base-relative URL of the parent page.</summary>
    [Parameter, EditorRequired]
    public string ParentHref { get; set; } = "";

    /// <summary>A line under the title, such as the company and the date of an offer.</summary>
    [Parameter]
    public RenderFragment? Subtitle { get; set; }

    /// <summary>Tags under the title, usually <see cref="Tag"/> components.</summary>
    [Parameter]
    public RenderFragment? Tags { get; set; }

    [Parameter]
    public RenderFragment? Actions { get; set; }

    /// <summary>The items of the ⋯ menu, as <c>&lt;li&gt;</c> holding a <c>menu-item</c>, such as
    /// <see cref="ArchiveMenuItem"/>.</summary>
    [Parameter]
    public RenderFragment? Menu { get; set; }
}
